<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} %-5level %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.apache.http" level="WARN"/>
    <root level="INFO">
        <appender-ref ref="Console"/>
    </root>
</configuration>
